			<hcontainer GUID="_5f4d3a2c-30f3-4e79-b2c3-9b1283e97208" class="prov1" eId="reg_1" name="regulation"><?DMS-Component componentId="e1649c05-972f-43a2-9501-1ab079d74bda" seriesId="0063cb57-3f2b-4553-85c5-3fbf83057829" versionNumber="1"?>
				
				<heading GUID="_cce7bec0-39b1-461b-9633-cacd73dfc53e" eId="reg_1__hdg">Citation and interpretation</heading>
				<num>1.</num>
				<paragraph GUID="_1906932c-7a99-4543-a103-fb2c7e2e583d" class="prov2" eId="reg_1__para_1">
					<num>(1)</num>
					<content>
						<p>These Regulations may be cited as the Product Security and Telecommunications Infrastructure Act 2022 (Commencement No. 1) Regulations 2023.</p>
					</content>
				</paragraph>
				<paragraph GUID="_d628c745-dbef-4275-93d7-000f0f4cb1ea" class="prov2" eId="reg_1__para_2">
					<num>(2)</num>
					<content>
						<p>In these Regulations “the Act” means the Product Security and Telecommunications Infrastructure Act 2022.</p>
					</content>
				</paragraph>
			</hcontainer>
			<hcontainer GUID="_b0f0f88e-c342-4379-985f-1008ed43515d" class="prov1" eId="reg_2" name="regulation"><?DMS-Component componentId="52650a17-6954-4d44-b724-f29d46578bdf" seriesId="0d869e30-5ee8-4d51-996d-c7760c1beb59" versionNumber="1"?>
				
				<heading GUID="_b8324d2c-2005-4790-a9a1-3e0856b66016" eId="reg_2__hdg">Provisions coming into force on 7th February 2023</heading>
				<num>2.</num>
				<intro GUID="_6497674b-9e3b-4e1b-b5f9-31d5cdf12227" eId="reg_2__intro">
					<p>The following provisions of the Act come into force on 7th February 2023—</p>
				</intro>
				<level GUID="_d02f1bb9-2732-4652-81ff-e32ecbe5bf9c" class="para1" eId="reg_2__para_a">
					<num>(a)</num>
					<content>
						<p>section 57 (rights under the electronic communications code to share apparatus);</p>
					</content>
				</level>
				<level GUID="_1358e172-a027-4ee8-aab6-f4cb041d58ef" class="para1" eId="reg_2__para_b">
					<num>(b)</num>
					<content>
						<p>section 60 (power to fly lines from apparatus kept by another operator);</p>
					</content>
				</level>
				<level GUID="_2f4651c1-8422-448d-887c-f8a8174451e7" class="para1" eId="reg_2__para_c">
					<num>(c)</num>
					<content>
						<p>section 75 (meaning of “the electronic communications code”).</p>
					</content>
				</level>
			</hcontainer>
