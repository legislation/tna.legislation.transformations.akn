				<hcontainer GUID="_f52f1f98-9e52-4a6d-aa7b-7a976bfebcf5" eId="sigs__sigBlk" name="signatureBlock">
					<content>
						<p>Signed by authority of the Secretary of State for Culture, Media and Sport</p>
						<block GUID="_b62ae58d-098b-49aa-84fd-218a15f604ee" eId="sigs__sigBlk__sig" name="signature">Name</block>
						<block GUID="_cb64a021-a1a8-431b-8e4b-02d7e96cdc4e" eId="sigs__sigBlk__role" name="role">Parliamentary Under Secretary of State</block>
						<block name="date"><date date="2023-12-01">Date</date></block>
						<block GUID="_e44e10ae-459c-4cf9-8abf-4a678de98dd5" eId="sigs__sigBlk__org" name="organization">Department for Culture, Media and Sport</block>
					</content>
				</hcontainer>
