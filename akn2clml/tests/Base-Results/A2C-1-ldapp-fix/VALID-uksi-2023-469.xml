			<?DMS-Component componentId="30f57237-7a2d-43c6-8179-834620ad1628" seriesId="1ddfb6f1-fdba-437b-b8dd-1687015520ba" versionNumber="0"?>
			<hcontainer GUID="_d7a1b125-f6aa-4739-9f70-4669ff033954" class="prov1" eId="reg_1" name="regulation">
				<?DMS-Component componentId="e5e6d461-099e-4de1-8fd5-4f84bf704769" seriesId="5e1557f1-edab-4cfd-9f22-f426642096ed" versionNumber="0"?>
				<heading GUID="_a6befbbb-0644-478a-8f02-2d913b888d80" eId="reg_1__hdg">Citation and interpretation</heading>
				<num>1.</num>
				<paragraph GUID="_b34c7ea7-17b5-46fb-814f-86dd0bb85c2c" class="prov2" eId="reg_1__para_1">
					<num>(1)</num>
					<content>
						<p>These Regulations may be cited as the Product Security and Telecommunications Infrastructure Act 2022 (Commencement No. 2) Regulations 2023.</p>
					</content>
				</paragraph>
				<paragraph GUID="_90d85701-bbff-4414-8866-f90411c7f006" class="prov2" eId="reg_1__para_2">
					<num>(2)</num>
					<content>
						<p>In these Regulations “the Act” means the Product Security and Telecommunications Infrastructure Act 2022.</p>
					</content>
				</paragraph>
			</hcontainer>
			<hcontainer GUID="_9431092c-0c90-4a5b-983e-c8d2ca857a08" class="prov1" eId="reg_2" name="regulation">
				<?DMS-Component componentId="7d6662d5-3439-4cf4-aa6a-a2ab67e40266" seriesId="5d4a3a10-40fb-4e3d-8f88-b2b31b141d4a" versionNumber="0"?>
				<heading GUID="_c3b88ea6-48ca-4d5a-93d3-562e40a94cc0" eId="reg_2__hdg">Provision coming into force on 26th April 2023</heading>
				<num>2.</num>
				<content>
					<p>Section 66 (refusal of application for code rights on grounds of national security etc) of the Act comes into force on 26th April 2023.</p>
				</content>
			</hcontainer>
			<hcontainer GUID="_2c31ccf1-98df-4697-bcca-16605d466ca4" class="prov1" eId="reg_3" name="regulation">
				<?DMS-Component componentId="2e3989a6-4b7a-47c3-b459-8e642f2d3adb" seriesId="5edc7488-bba6-444b-8ac8-e0cd6f996bd7" versionNumber="0"?>
				<heading GUID="_0047826a-c177-4c38-9345-8d99b0d44f19" eId="reg_3__hdg">Provisions coming into force on 29th April 2024</heading>
				<num>3.</num>
				<content>
					<p>Part 1 of the Act comes into force on 29th April 2024, so far as not already in force.</p>
				</content>
			</hcontainer>
