      <Body>
         <P1group>
            <Title>Citation, commencement and extent</Title>
            <P1 id="article-1">
               <Pnumber>1</Pnumber>
               <P1para>
                  <P2 id="article-1-1">
                     <Pnumber>1</Pnumber>
                     <P2para>
                        <Text>This Order may be cited as the School Teachers’ Incentive Payments (England) (Amendment) Order 2023 and comes into force on 1st September 2023.</Text>
                     </P2para>
                  </P2>
                  <P2 id="article-1-2">
                     <Pnumber>2</Pnumber>
                     <P2para>
                        <Text>This Order extends to England and Wales.</Text>
                     </P2para>
                  </P2>
               </P1para>
            </P1>
         </P1group>
         <P1group>
            <Title>Amendment of the School Teachers’ Incentive Payments (England) Order 2019</Title>
            <P1 id="article-2">
               <Pnumber>2</Pnumber>
               <P1para>
                  <P2 id="article-2-1">
                     <Pnumber>1</Pnumber>
                     <P2para>
                        <Text>The School Teachers’ Incentive Payments (England) Order 2019<FootnoteRef Ref="f00002"/> is amended as follows.</Text>
                     </P2para>
                  </P2>
                  <P2 id="article-2-2">
                     <Pnumber>2</Pnumber>
                     <P2para>
                        <Text>In article 2(2) (incentive payments to school teachers)—</Text>
                        <P3 id="article-2-2-a">
                           <Pnumber>a</Pnumber>
                           <P3para>
                              <Text>in sub-paragraph (c) omit “and”; and</Text>
                           </P3para>
                        </P3>
                        <P3 id="article-2-2-b">
                           <Pnumber>b</Pnumber>
                           <P3para>
                              <Text>after sub-paragraph (d) insert—</Text>
                              <BlockAmendment TargetClass="secondary"
                                              TargetSubClass="unknown"
                                              Context="main"
                                              Format="double"/>
                              <AppendText>“and</AppendText>
                           </P3para>
                        </P3>
                        <P3 id="article-2-2-e">
                           <Pnumber>e</Pnumber>
                           <P3para>
                              <Text>the International Relocation Payment,”</Text>
                           </P3para>
                        </P3>
                     </P2para>
                  </P2>
               </P1para>
            </P1>
         </P1group>
         <SignedSection>
