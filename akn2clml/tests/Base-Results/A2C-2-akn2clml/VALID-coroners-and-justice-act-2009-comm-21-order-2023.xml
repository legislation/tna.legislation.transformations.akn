         <Title> The Coroners and Justice Act 2009 (Commencement No. 21) Order 2023  </Title>
         <MadeDate>
            <Text>Made</Text>
            <DateText>20th September 2023</DateText>
         </MadeDate>
         <SecondaryPreamble>
            <EnactingText>
               <Para>
                  <Text>The Secretary of State makes this Order in exercise of the power conferred by section 182(5) of the Coroners and Justice Act 2009<FootnoteRef Ref="f00001"/>.</Text>
               </Para>
            </EnactingText>
         </SecondaryPreamble>
