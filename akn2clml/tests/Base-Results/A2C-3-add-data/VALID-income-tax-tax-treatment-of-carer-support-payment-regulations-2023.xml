            <Title>Citation, commencement and interpretation</Title>
            <P1 id="regulation-1">
               <Pnumber>1</Pnumber>
               <P1para>
                  <P2 id="regulation-1-1">
                     <Pnumber>1</Pnumber>
                     <P2para>
                        <Text>These Regulations may be cited as the Income Tax (Tax Treatment of Carer Support Payment and Exemption of Social Security Benefits) Regulations 2023 and come into force on 19th November 2023.</Text>
                     </P2para>
                  </P2>
                  <P2 id="regulation-1-2">
                     <Pnumber>2</Pnumber>
                     <P2para>
                        <Text>In these Regulations, “ITEPA” means the Income Tax (Earnings and Pensions) Act 2003<FootnoteRef Ref="f00003"/>.</Text>
                     </P2para>
                  </P2>
               </P1para>
